{
  "name": "hitari-blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://hidari123.github.io",
  "scripts": {
    "dev": "vite",
    "deploy": "gh-pages -d dist",
    "tsc": "tsc --noEmit",
    "vite-build": "vite build",
    "build": "npm run tsc && npm run vite-build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:secrets": "node scripts/audit-secrets.cjs dist",
    "analyze:bundle": "vite build --sourcemap && node scripts/analyze-bundle.cjs",
    "fetch:model": "node scripts/fetch-model.cjs",
    "preview": "vite preview",
    "new-post": "node scripts/new-post.js"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@iconify/react": "^6.0.2",
    "@types/prismjs": "^1.26.6",
    "framer-motion": "^10.18.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.303.0",
    "onnxruntime-web": "^1.26.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-kawaii": "^1.6.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.21.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "~0.4.26",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-gh-pages": "^1.0.1",
    "vitest": "^2.1.9"
  }
}
